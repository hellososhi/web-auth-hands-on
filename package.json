{
  "name": "web-auth-hands-on",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "prisma generate && next build",
    "start": "next start --hostname localhost",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:setup": "node --import tsx scripts/db.ts setup",
    "db:migrate": "node --import tsx scripts/db.ts migrate",
    "db:generate": "prisma generate",
    "db:seed": "node --import tsx scripts/db.ts seed",
    "db:studio": "prisma studio",
    "db:reset": "node --import tsx scripts/db.ts reset",
    "test": "prisma generate && vitest run",
    "test:watch": "prisma generate && vitest",
    "docs:check": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "dotenv": "18.0.10",
    "hono": "4.13.19",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}

